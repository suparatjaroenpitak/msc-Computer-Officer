{
  "name": "msc-computer-officer-study",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && tsx scripts/deploy-db-migration.ts && tsx prisma/seed.ts --if-needed && next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:vercel": "tsx scripts/deploy-db-migration.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:if-needed": "tsx prisma/seed.ts --if-needed",
    "content:curate": "python scripts/build-user-study-set.py"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@next-auth/prisma-adapter": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "next-auth": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "6.19.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
